# Uzak Ollama sunucusu (kendi sunucu IP'ni yaz)
OLLAMA_BASE_URL=http://172.16.10.141:11434/
OLLAMA_CHAT_MODEL=qwen2.5:14b-instruct
OLLAMA_EMBED_MODEL=bge-m3

# Yerel Docker servisleri (docker compose up ile ayaklanir)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=albay_chunks
QDRANT_REGULATIONS_COLLECTION=albay_regulations
TAX_OFFICE_ORG_TYPE=baskanlik
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://albay:albay_dev_pw@localhost:5432/albay_rag
DOCLING_URL=http://localhost:5001
# Reranker (TEI). Apple Silicon'da calismaz — Mac'te TANIMSIZ birak (rerank atlanir).
# Bos string gecersiz: deger verilecekse tam URL olmali.
# x86 Linux'ta: docker compose --profile rerank up -d  ->  http://localhost:8080
# RERANKER_URL=http://localhost:8080

# ─── API ve web arayuzu ───────────────────────────────────────────────
API_PORT=3001
API_HOST=127.0.0.1
# Arayuzun adresi (CORS). Virgulle birden fazla verilebilir.
WEB_ORIGIN=http://localhost:5173
# Yuklenen evraklarin diske yazildigi klasor
UPLOAD_DIR=data/uploads
# Tek dosya yukleme siniri (MB)
UPLOAD_MAX_MB=25

# ─── Faz 5c: resmi cevap yazisi anteti ────────────────────────────────
# Bunlar kuruma ozgudur ve sistem tarafindan BILINEMEZ. Bos birakilan her alan
# yazida gorunur bir yer tutucu ([DETSIS NO] gibi) olarak basilir ve API
# yanitindaki eksikAlanlar listesinde raporlanir — hicbiri uydurulmaz.
LETTER_KURUM_ADI=
LETTER_BIRIM_ADI=
# DETSIS (Devlet Teskilati Merkezi Kayit Sistemi) numarasi — "Sayi" alaninin ilk blogu
LETTER_DETSIS_NO=
# Standart Dosya Plani kodu (orn. 045.01)
LETTER_DOSYA_PLANI=
LETTER_IMZA_AD=
LETTER_IMZA_UNVAN=
LETTER_ADRES=
LETTER_TELEFON=
LETTER_EPOSTA=
LETTER_WEB=
LETTER_KEP=

# Faz 0 eval — RAGFlow baseline (RAGFlow API adresin ve anahtarin)
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
